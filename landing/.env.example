# Salin menjadi .env.local bila perlu. Landing page tidak memakai kunci atau rahasia apa pun.

# URL landing page sendiri (metadata, robots, sitemap). Kosong = domain produksi Vercel proyek ini.
NEXT_PUBLIC_SITE_URL=

# URL dashboard untuk tombol "Masuk". Kosong = https://miftahulugohh.vercel.app (lokal: http://localhost:3000).
NEXT_PUBLIC_DASHBOARD_URL=
