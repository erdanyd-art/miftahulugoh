# Salin menjadi .env.local lalu isi. Jangan commit nilai asli.
# Nilai lokal muncul setelah `npx supabase start` (atau `npx supabase status`).

# Boleh terlihat di browser (dilindungi RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# HANYA untuk server. Jangan pernah diberi awalan NEXT_PUBLIC_ dan jangan dipakai di komponen klien.
SUPABASE_SERVICE_ROLE_KEY=

# URL situs untuk metadata/robots/sitemap landing page. Isi setelah domain sendiri dipasang,
# mis. https://contoh.id. Kosong = memakai domain produksi Vercel.
NEXT_PUBLIC_SITE_URL=
